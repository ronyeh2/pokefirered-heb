Help_Text_HowToUsePokedex::
	.string "{CIRCLE_1} בחר ”פוקדקס” בתפריט.\n"
	.string "{CIRCLE_2} בחר פוקימון בעזרת פקודות\n"
	.string "   כמו ”רשימת פוקימון”,\n"
	.string "   ”בתי גידול פוקימון”\n"
	.string "   ו”חיפוש”.\n"
	.string "{CIRCLE_3} בחר פוקימון כדי לקבל\n"
	.string "   מידע מפורט.$"

Help_Text_HowToUsePokemon::
	.string "{CIRCLE_1} בחר ”פוקימון” בתפריט.\n"
	.string "{CIRCLE_2} בחר פוקימון מהקבוצה שלך.\n"
	.string "{CIRCLE_3} בחר ”סיכום”, ”החלף”\n"
	.string "   או ”פריט”.$"

Help_Text_HowToUseSummary::
	.string "{CIRCLE_1} בחר ”סיכום”.\n"
	.string "{CIRCLE_2} לחץ שמאלה או ימינה על {PLUS}\n"
	.string "   בפד השליטה כדי לראות:\n"
	.string "   ”מידע פוקימון”\n"
	.string "   ”כישורי פוקימון”\n"
	.string "   ”מהלכים ידועים”$"

Help_Text_HowToUseSwitch::
	.string "{CIRCLE_1} בחר את הפוקימון שברצונך\n"
	.string "   להחליף.\n"
	.string "{CIRCLE_2} בחר ”החלף”.\n"
	.string "{CIRCLE_3} בחר את הפוקימון שיבוא\n"
	.string "   במקומו.\n"
	.string "הפוקימון שבצד שמאל של המסך\n"
	.string "יוצא ראשון לקרב.$"

Help_Text_HowToUseItem::
	.string "{CIRCLE_1} בחר ”פריט”.\n"
	.string "{CIRCLE_2} בחר ”תן” כדי למסור\n"
	.string "   לפוקימון פריט להחזיק,\n"
	.string "   או ”קח” כדי לקחת פריט.\n"
	.string "פוקימון יכול להחזיק\n"
	.string "פריט אחד בלבד!$"

Help_Text_HowToUseBag::
	.string "{CIRCLE_1} בחר ”תיק” בתפריט.\n"
	.string "{CIRCLE_2} לחץ שמאלה או ימינה על {PLUS}\n"
	.string "   בפד השליטה כדי לעבור בין:\n"
	.string "   ”פריטים”\n"
	.string "   ”פריטי מפתח”\n"
	.string "   ”פוקיבולים”\n"
	.string "   לחץ למעלה או למטה לבחור פריט.$"

Help_Text_HowToUseAnItem::
	.string "{CIRCLE_1} בחר את כיס ”פריטים”.\n"
	.string "{CIRCLE_2} לחץ למעלה או למטה על {PLUS}\n"
	.string "   בפד השליטה לבחירת פריט.\n"
	.string "{CIRCLE_3} בחר ”השתמש” כדי להשתמש\n"
	.string "   בפריט שנבחר.\n"
	.string "יש פריטים שאי אפשר להשתמש בהם\n"
	.string "בכל מקום או בכל מצב.$"

Help_Text_HowToUseKeyItem::
	.string "{CIRCLE_1} בחר את כיס ”פריטי מפתח”.\n"
	.string "{CIRCLE_2} לחץ למעלה או למטה על {PLUS}\n"
	.string "   בפד השליטה לבחירת הפריט.\n"
	.string "{CIRCLE_3} בחר ”השתמש” כדי להשתמש\n"
	.string "   בפריט המפתח שנבחר.$"

Help_Text_HowToUsePokeBall::
	.string "{CIRCLE_1} בזמן קרב מול פוקימון פראי,\n"
	.string "   פתח את כיס ”פוקיבולים”\n"
	.string "   בתיק.\n"
	.string "{CIRCLE_2} לחץ למעלה או למטה על {PLUS}\n"
	.string "   בפד השליטה לבחירת פוקיבול.\n"
	.string "{CIRCLE_3} בחר ”השתמש” כדי לזרוק\n"
	.string "   את הפוקיבול שנבחר.$"

Help_Text_HowToUsePlayer::
	.string "{CIRCLE_1} בחר ”{PLAYER}” בתפריט.\n"
	.string "{CIRCLE_2} כרטיס המאמן שלך מוצג עם\n"
	.string "   המידע הבסיסי. לחץ על הכפתור A\n"
	.string "   כדי להפוך את הכרטיס.\n"
	.string "{CIRCLE_3} בצד השני של הכרטיס\n"
	.string "   יש מידע נוסף ומגוון.$"

Help_Text_HowToUseSave::
	.string "{CIRCLE_1} בחר ”שמירה” בתפריט.\n"
	.string "{CIRCLE_2} בחר ”כן” וההתקדמות שלך\n"
	.string "   תישמר בקובץ השמירה.\n"
	.string "אחרי השמירה אפשר לכבות\n"
	.string "את המשחק ולהמשיך בפעם הבאה\n"
	.string "מהנקודה שבה שמרת.$"

Help_Text_HowToUseOption::
	.string "{CIRCLE_1} בחר ”אפשרויות” בתפריט.\n"
	.string "{CIRCLE_2} לחץ למעלה או למטה על {PLUS}\n"
	.string "   בפד השליטה לבחירת הגדרה,\n"
	.string "   ואז לחץ שמאלה או ימינה\n"
	.string "   כדי לשנות אותה.\n"
	.string "{CIRCLE_3} בסיום בחר ”ביטול” או לחץ\n"
	.string "   על הכפתור B.$"

Help_Text_HowToUsePotion::
	.string "{CIRCLE_1} פתח את התפריט.\n"
	.string "{CIRCLE_2} לחץ למעלה או למטה על {PLUS}\n"
	.string "   בפד השליטה ובחר ”תיק”.\n"
	.string "{CIRCLE_3} בחר ”שיקוי” בכיס\n"
	.string "   ”פריטים”.\n"
	.string "{CIRCLE_4} בחר ”השתמש”.\n"
	.string "{CIRCLE_5} בחר את הפוקימון לריפוי.$"

Help_Text_HowToUseTownMap::
	.string "{CIRCLE_1} פתח את התפריט.\n"
	.string "{CIRCLE_2} לחץ למעלה או למטה על {PLUS}\n"
	.string "   בפד השליטה ובחר ”תיק”.\n"
	.string "{CIRCLE_3} לחץ שמאלה או ימינה כדי\n"
	.string "   לפתוח את כיס ”פריטי מפתח”,\n"
	.string "   ואז בחר ”מפת העיר”.\n"
	.string "{CIRCLE_4} בחר ”השתמש” לפתיחת המפה.$"

Help_Text_HowToUseTM::
	.string "{CIRCLE_1} פתח את התפריט.\n"
	.string "{CIRCLE_2} פתח את כיס ”פריטי מפתח”\n"
	.string "   שב”תיק”.\n"
	.string "{CIRCLE_3} ”פתח” את תיק המ”מ.\n"
	.string "{CIRCLE_4} בחר ”השתמש” במ”מ.\n"
	.string "{CIRCLE_5} בחר פוקימון שיכול ללמוד\n"
	.string "   את המהלך שבמ”מ.$"

Help_Text_HowToUseHM::
	.string "{CIRCLE_1} פתח את התפריט.\n"
	.string "{CIRCLE_2} פתח את כיס ”פריטי מפתח”\n"
	.string "   שב”תיק”.\n"
	.string "{CIRCLE_3} ”פתח” את תיק המ”מ.\n"
	.string "{CIRCLE_4} בחר ”השתמש” במ”נ.\n"
	.string "{CIRCLE_5} בחר פוקימון שיכול ללמוד אותו.\n"
	.string "קשה למחוק מהלך של מ”נ, אז היזהר!$"

Help_Text_HowToUseMoveOutsideOfBattle::
	.string "{CIRCLE_1} פתח את התפריט.\n"
	.string "{CIRCLE_2} בחר ”פוקימון”.\n"
	.string "{CIRCLE_3} בחר פוקימון שיודע\n"
	.string "   מהלך נסתר. המהלכים שאפשר\n"
	.string "   להשתמש בהם מופיעים בכחול.\n"
	.string "   בחר את המהלך הרצוי כדי לנפץ\n"
	.string "   מכשול, לעוף, לגלוש ועוד.$"

Help_Text_HowToRideBicycle::
	.string "{CIRCLE_1} פתח את התפריט, פתח את\n"
	.string "   כיס ”פריטי מפתח” שב”תיק”\n"
	.string "   ובחר ”אופניים”.\n"
	.string "{CIRCLE_2} בחירה ב”השתמש” תעלה\n"
	.string "   אותך על האופניים. אפשר גם\n"
	.string "   לבחור ”רשום” לשימוש מהיר\n"
	.string "   בלחיצה על כפתור סלקט.$"

Help_Text_HowToEnterName::
	.string "{CIRCLE_1} הזז את הסמן לאות הרצויה\n"
	.string "   עם {PLUS} בפד השליטה, ואז לחץ\n"
	.string "   על הכפתור A כדי להזין.\n"
	.string "{CIRCLE_2} לחץ על הכפתור B כדי למחוק.\n"
	.string "{CIRCLE_3} לחץ על כפתור סלקט כדי\n"
	.string "   להחליף בין סוגי האותיות.\n"
	.string "{CIRCLE_4} סיים בלחיצה על ”אישור”.$"

Help_Text_HowToUsePC::
	.string "{CIRCLE_1} גש למרכז פוקימון, עמוד מול\n"
	.string "   המחשב ולחץ על הכפתור A.$"

Help_Text_HowToUseBillsPC::
	.string "{CIRCLE_1} בחר ”מחשב של {STR_VAR_1}” במחשב.\n"
	.string "{CIRCLE_2} בחר באחת משלוש האפשרויות\n"
	.string "   העליונות כדי להיכנס למערכת\n"
	.string "   אחסון הפוקימונים.\n"
	.string "אם תתפוס פוקימון ויש לך כבר\n"
	.string "שישה בקבוצה, הוא יישלח\n"
	.string "אוטומטית לתיבה במערכת!$"

Help_Text_HowToUseWithdraw::
	.string "{CIRCLE_1} בחר פוקימון בתיבה הפתוחה\n"
	.string "   עם {PLUS} בפד השליטה.\n"
	.string "{CIRCLE_2} בחר ”משוך” כדי להוציא\n"
	.string "   אותו מהתיבה ולהוסיף\n"
	.string "   לקבוצה שלך.\n"
	.string "אי אפשר למשוך פוקימון אם כבר\n"
